generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
}

enum VendorType {
  SHOP
  RESTAURANT
  GROCERY
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  vendor    Vendor?
  delivery  DeliveryBoy?
  addresses Address[]
  orders    Order[]      @relation("CustomerOrders")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  label     String
  line      String
  lat       Float?
  lng       Float?
  isDefault Boolean @default(false)
}

model Vendor {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  businessName   String
  type           VendorType
  logoUrl        String?
  status         VendorStatus @default(PENDING)
  commissionRate Float        @default(10)
  createdAt      DateTime     @default(now())

  products Product[]
  orders   Order[]
}

model Category {
  id       String     @id @default(cuid())
  name     String
  parentId String?
  imageUrl String?
  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  name           String
  description    String?
  price          Float
  discountPrice  Float?
  stock          Int      @default(0)
  unit           String   @default("pcs")
  imageUrl       String?
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())

  orderItems OrderItem[]
}

model DeliveryBoy {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  vehicleType String?
  isAvailable Boolean  @default(false)
  currentLat  Float?
  currentLng  Float?

  orders Order[]
}

model Order {
  id           String      @id @default(cuid())
  customerId   String
  customer     User        @relation("CustomerOrders", fields: [customerId], references: [id])
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  deliveryId   String?
  deliveryBoy  DeliveryBoy? @relation(fields: [deliveryId], references: [id])
  status       OrderStatus @default(PLACED)
  subtotal     Float
  deliveryFee  Float       @default(0)
  total        Float
  paymentMethod String     @default("COD")
  paymentStatus String     @default("PENDING")
  createdAt    DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Float
}
